{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["route_code", "direction", "stops"],
  "properties": {
    "route_code": {"type": "string", "minLength": 1},
    "direction": {"type": "string", "minLength": 1},
    "stops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "lat", "lon", "stop_order", "arrival_at", "departure_at"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "lat": {"type": "number", "minimum": -90, "maximum": 90},
          "lon": {"type": "number", "minimum": -180, "maximum": 180},
          "stop_order": {"type": "integer", "minimum": 1},
          "arrival_at": {"type": "string"},
          "departure_at": {"type": "string"}
        }
      }
    }
  }
}